          // ---- Ambient background drift ----
          tl.fromTo("#glow-a", { x: 0, y: 0 }, { x: 120, y: 60, duration: 23.4, ease: "sine.inOut" }, 0);
          tl.fromTo("#glow-b", { x: 0, y: 0 }, { x: -100, y: -50, duration: 23.4, ease: "sine.inOut" }, 0);

          // ---- Audio-reactive: music RMS/bass warms the glows, hero panel, and wordmark ----
          var AD = window.AUDIO_DATA;
          var glowA = document.getElementById("glow-a");
          var glowB = document.getElementById("glow-b");
          var panel = document.getElementById("hero-panel");
          var word = document.getElementById("wordmark");
          var frames = Math.min(AD.rms.length, Math.floor(23.4 * AD.fps));
          for (var f = 0; f < frames; f++) {
            tl.call(
              (function (rms, bass) {
                return function () {
                  glowA.style.opacity = (0.7 + 0.3 * rms).toFixed(3);
                  glowB.style.opacity = (0.6 + 0.4 * bass).toFixed(3);
                  panel.style.boxShadow = "0 18px " + (40 + 50 * rms).toFixed(1) + "px rgba(26, 74, 44, " + (0.25 + 0.25 * bass).toFixed(3) + ")";
                  word.style.textShadow = "0 8px " + (18 + 22 * rms).toFixed(1) + "px rgba(36, 96, 58, " + (0.12 + 0.14 * bass).toFixed(3) + ")";
                };
              })(AD.rms[f], AD.bass[f]),
              [],
              f / AD.fps
            );
          }

          window.__timelines["main"] = tl;
        }

        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(build);
        } else {
          build();
        }
      })();
    </script>
  </body>
</html>
