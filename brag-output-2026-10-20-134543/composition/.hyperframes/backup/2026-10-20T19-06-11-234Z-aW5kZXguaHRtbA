      .slot {
        position: relative;
      }
      .muted {
        color: var(--muted);
      }
      .dl {
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        gap: 6px 24px;
      }
      .dt {
        font-size: 20px;
        color: var(--muted);
      }
      .dd {
        font-size: 24px;
        font-weight: 600;
      }
      .form-row {
        border-top: 1.5px solid var(--line);
